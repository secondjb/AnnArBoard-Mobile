<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/transparent">

    <!-- Header Row: Route Title & Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_route_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="CCTC → Pierpont"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_route_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#00274C"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="CN"
            android:textColor="#FFCB05"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#334155" />

    <!-- Label above primary ETA -->
    <TextView
        android:id="@+id/tv_label_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT BUS"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- Primary ETA (Large Bold) -->
    <TextView
        android:id="@+id/tv_eta_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7 min"
        android:textColor="#FFCB05"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Subtitle: Arrival time & ride duration -->
    <TextView
        android:id="@+id/tv_arrival_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Arrives ~7:48 AM · 18 min ride"
        android:textColor="#E2E8F0"
        android:textSize="14sp" />

    <!-- Google Maps Navigation Style Progress Track & Circular Thumb -->
    <RelativeLayout
        android:id="@+id/rl_progress_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <View
            android:id="@+id/view_track_bg"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_progress_track_rounded" />

        <ProgressBar
            android:id="@+id/notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_centerVertical="true"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/drawable_progress_bar_rounded" />

        <FrameLayout
            android:id="@+id/fl_bus_thumb"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_bus_thumb_circle">

            <ImageView
                android:id="@+id/iv_bus_thumb_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bus_dark" />
        </FrameLayout>

    </RelativeLayout>

    <!-- Secondary Upcoming Buses -->
    <TextView
        android:id="@+id/tv_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Also coming: 17 min, 27 min"
        android:textColor="#CCCCCC"
        android:textSize="13sp" />

</LinearLayout>
